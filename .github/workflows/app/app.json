{
  "expo": {
    "name": "پیک",
    "slug": "peyk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "peyk",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#20222F" },
    "ios": {
      "bundleIdentifier": "com.peyk.app",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "NSMicrophoneUsageDescription": "برای ضبط پیام صوتی به میکروفون نیاز است.",
        "NSContactsUsageDescription": "برای پیدا کردن دوستانتان که از پیک استفاده می‌کنند.",
        "NSPhotoLibraryUsageDescription": "برای ارسال عکس و ویدیو.",
        "NSCameraUsageDescription": "برای گرفتن عکس و ویدیو."
      }
    },
    "android": {
      "package": "com.peyk.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-bg.png",
        "backgroundColor": "#20222F"
      },
      "permissions": ["RECORD_AUDIO", "READ_CONTACTS", "POST_NOTIFICATIONS", "CAMERA", "VIBRATE"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#FD1D3F" }],
      ["expo-contacts", { "contactsPermission": "برای پیدا کردن دوستانتان که از پیک استفاده می‌کنند." }],
      ["expo-av", { "microphonePermission": "برای ضبط پیام صوتی به میکروفون نیاز است." }],
      ["expo-image-picker", { "photosPermission": "برای ارسال عکس و ویدیو.", "cameraPermission": "برای گرفتن عکس و ویدیو." }],
      ["expo-localization", { "supportedLocales": { "ios": ["fa"], "android": ["fa"] } }]
    ],
    "extra": { "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" } }
  }
}
